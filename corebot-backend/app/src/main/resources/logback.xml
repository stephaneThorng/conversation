<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} level=%-5level thread=%thread logger=%logger{48} msg="%msg"%n</pattern>
        </encoder>
    </appender>
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>logs/corebot-backend.log</file>
        <append>false</append>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} level=%-5level thread=%thread logger=%logger{48} msg="%msg"%n</pattern>
        </encoder>
    </appender>

    <logger name="org.eclipse.jetty" level="INFO" />
    <logger name="io.javalin" level="ERROR" />
    <logger name="dev.stephyu.conversation.adapter.outbound.llm" level="DEBUG" />
    <logger name="dev.stephyu.conversation.application.orchestration" level="DEBUG" />

    <root level="INFO">
        <appender-ref ref="STDOUT" />
        <appender-ref ref="FILE" />
    </root>
</configuration>
